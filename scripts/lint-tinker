#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Typecheck the Tinker compatibility layer on Python >= 3.11 with tinker installed.
# The main ./scripts/lint job runs on 3.10 and excludes these paths.

root="$(pwd)"
status=0
# Config must live in the repo root so relative includes resolve and first-party
# `together` imports work. XXXXXX must be at the end for GNU mktemp (CI).
pyright_cfg="$(mktemp "${root}/.pyright-tinker.XXXXXX.json")"
mypy_cfg="$(mktemp)"
trap 'rm -f "$pyright_cfg" "$mypy_cfg"' EXIT

echo "==> Running pyright on tinker compatibility layer"
# Bypass pyproject.toml excludes (3.10-oriented) with a one-off config.
cat >"$pyright_cfg" <<EOF
{
  "include": [
    "src/together/lib/beta/rl/tinker",
    "tests/unit/test_rl_tinker_wrapper.py"
  ],
  "typeCheckingMode": "strict",
  "pythonVersion": "3.11",
  "reportImplicitOverride": true,
  "reportOverlappingOverload": false,
  "reportImportCycles": false,
  "reportPrivateUsage": false,
  "reportUnusedFunction": false,
  "reportUnusedClass": false,
  "reportMissingTypeStubs": false,
  "reportUnknownMemberType": false
}
EOF

uv run --python 3.11 pyright --project "$pyright_cfg" || status=1

echo "==> Running mypy on tinker compatibility layer"
cat >"$mypy_cfg" <<'EOF'
[mypy]
python_version = 3.11
pretty = true
show_error_codes = true
strict_equality = true
implicit_reexport = true
check_untyped_defs = true
no_implicit_optional = true
warn_return_any = true
warn_unreachable = true
warn_unused_configs = true
warn_unused_ignores = false
warn_redundant_casts = false
disallow_any_generics = true
disallow_untyped_defs = true
disallow_untyped_calls = true
disallow_subclassing_any = true
disallow_incomplete_defs = true
disallow_untyped_decorators = true
cache_fine_grained = true
disable_error_code = func-returns-value,overload-cannot-match
EOF

# mypy forbids mixing -p and file paths; package only (tests are covered by pyright).
# Matching the main mypy job, which excludes tests/.* .
uv run --python 3.11 mypy --config-file="$mypy_cfg" -p together.lib.beta.rl.tinker || status=1

exit "$status"
